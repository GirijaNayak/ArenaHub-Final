# ArenaHub — Environment Variable Template
# Copy to .env for local development

# Database connection
# PostgreSQL connection string (Vercel, Neon, Supabase, AWS RDS, Docker):
DATABASE_URL="postgresql://username:password@ep-example-host.region.aws.neon.tech/neondb?sslmode=require"

# Legacy local SQLite (archived backup):
# DATABASE_URL="file:./dev.db"

# Authentication secret (Minimum 32 random characters for JWT HS256 signing)
AUTH_SECRET="arenahub-super-secret-development-key-32-chars-long!"

# App environment
NODE_ENV="development"
PORT=3000
