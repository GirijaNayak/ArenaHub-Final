generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                   @id @default(cuid())
  email                 String                   @unique
  passwordHash          String
  name                  String
  username              String                   @unique
  role                  String                   @default("PLAYER") // "PLAYER", "TEAM_CAPTAIN", "TOURNAMENT_ORGANIZER", "REFEREE", "SPECTATOR", "PLATFORM_ADMIN"
  avatarUrl             String?
  bio                   String?
  phone                 String?
  inGameId              String?                  // e.g. BGMI Character ID
  inGameName            String?                  // e.g. BGMI IGN
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  ownedOrganizations    Organization[]           @relation("OrganizationOwner")
  orgMemberships        OrgMembership[]
  teamsLed              Team[]                   @relation("TeamCaptain")
  teamPlayerProfiles    TeamPlayer[]
  tournamentsOrganized  Tournament[]             @relation("TournamentOrganizer")
  registrationsCreated  TournamentRegistration[]
  resultsSubmitted      LobbyResult[]            @relation("ResultSubmitter")
  resultsVerified       LobbyResult[]            @relation("ResultVerifier")
  disputesRaised        Dispute[]                @relation("DisputeRaiser")
  disputesAssigned      Dispute[]                @relation("DisputeReferee")
  notifications         Notification[]
  auditLogs             AuditLog[]
}

model Organization {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  logoUrl     String?
  description String?
  status      String          @default("ACTIVE") // "ACTIVE", "SUSPENDED"
  ownerId     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner       User            @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     OrgMembership[]
  tournaments Tournament[]
  auditLogs   AuditLog[]
}

model OrgMembership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("TOURNAMENT_ORGANIZER") // "TOURNAMENT_ORGANIZER", "REFEREE", "MEMBER"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Team {
  id                      String                   @id @default(cuid())
  name                    String
  tag                     String                   @unique
  logoUrl                 String?
  description             String?
  captainId               String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  captain                 User                     @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: Cascade)
  players                 TeamPlayer[]
  tournamentRegistrations TournamentRegistration[]
  lobbyAssignments        LobbyTeam[]
  lobbyResults            LobbyResult[]
  disputes                Dispute[]
}

model TeamPlayer {
  id         String   @id @default(cuid())
  teamId     String
  userId     String?
  playerName String   // In-Game Name (IGN)
  inGameId   String   // Game Character ID
  role       String   @default("PLAYER") // "CAPTAIN", "PLAYER", "SUBSTITUTE"
  joinedAt   DateTime @default(now())

  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([teamId, inGameId])
}

model Tournament {
  id                String                   @id @default(cuid())
  organizationId    String
  organizerId       String
  title             String
  slug              String                   @unique
  description       String
  game              String                   @default("BGMI") // "BGMI", "PUBG Mobile", "Apex Legends", "FreeFire"
  bannerUrl         String?
  rules             String
  teamCapacity      Int                      @default(20) // e.g. 20, 25, 40, 60 squads
  teamSize          Int                      @default(4) // 4 players per squad
  scoringConfig     String                   // JSON string mapping placements to points + kill multiplier
  registrationStart DateTime
  registrationEnd   DateTime
  tournamentStart   DateTime
  tournamentEnd     DateTime?
  status            String                   @default("DRAFT") // "DRAFT", "REGISTRATION_OPEN", "REGISTRATION_CLOSED", "LIVE", "COMPLETED", "CANCELLED"
  isFeatured        Boolean                  @default(false)
  prizePool         Int                      @default(0)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizer         User                     @relation("TournamentOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  registrations     TournamentRegistration[]
  lobbies           Lobby[]
  disputes          Dispute[]
}

model TournamentRegistration {
  id             String     @id @default(cuid())
  tournamentId   String
  teamId         String
  registeredById String
  status         String     @default("CONFIRMED") // "PENDING", "CONFIRMED", "REJECTED", "CANCELLED"
  seed           Int?
  registeredAt   DateTime   @default(now())

  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team           Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registeredBy   User       @relation(fields: [registeredById], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
}

model Lobby {
  id            String        @id @default(cuid())
  tournamentId  String
  lobbyNumber   Int
  title         String        // e.g. "Match 1 - Erangel", "Group A - Miramar"
  mapName       String        @default("Erangel") // "Erangel", "Miramar", "Sanhok", "Vikendi"
  scheduledTime DateTime
  revealTime    DateTime      // Exact UTC time when Room ID/Password are revealed to assigned teams
  roomId        String?       // Private Room ID
  roomPassword  String?       // Private Room Password
  status        String        @default("SCHEDULED") // "SCHEDULED", "ROOM_POSTED", "LIVE", "RESULTS_PENDING", "COMPLETED", "CANCELLED"
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tournament    Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams         LobbyTeam[]
  results       LobbyResult[]
  disputes      Dispute[]

  @@index([tournamentId, lobbyNumber])
}

model LobbyTeam {
  id         String   @id @default(cuid())
  lobbyId    String
  teamId     String
  slotNumber Int      // Assigned room slot (1 to 25)
  assignedAt DateTime @default(now())

  lobby      Lobby    @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([lobbyId, teamId])
  @@unique([lobbyId, slotNumber])
}

model LobbyResult {
  id              String    @id @default(cuid())
  lobbyId         String
  teamId          String
  placement       Int       // 1st, 2nd, 3rd, ...
  kills           Int       @default(0)
  placementPoints Int       @default(0)
  killPoints      Int       @default(0)
  totalPoints     Int       @default(0)
  status          String    @default("SUBMITTED") // "DRAFT", "SUBMITTED", "VERIFIED", "DISPUTED"
  screenshotUrl   String?
  submittedById   String?
  verifiedById    String?
  submittedAt     DateTime  @default(now())
  verifiedAt      DateTime?

  lobby           Lobby     @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submittedBy     User?     @relation("ResultSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  verifiedBy      User?     @relation("ResultVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  disputes        Dispute[]

  @@unique([lobbyId, teamId])
}

model Dispute {
  id              String       @id @default(cuid())
  tournamentId    String
  lobbyId         String
  teamId          String
  resultId        String?
  raisedById      String
  refereeId       String?
  reason          String       // "INCORRECT_KILLS", "INCORRECT_PLACEMENT", "UNAUTHORIZED_PLAYER", "ROOM_TIMING_ISSUE", "OTHER"
  description     String
  evidenceUrl     String?
  status          String       @default("OPEN") // "OPEN", "UNDER_REVIEW", "RESOLVED", "REJECTED"
  resolutionNotes String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  resolvedAt      DateTime?

  tournament      Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  lobby           Lobby        @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  team            Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  result          LobbyResult? @relation(fields: [resultId], references: [id], onDelete: SetNull)
  raisedBy        User         @relation("DisputeRaiser", fields: [raisedById], references: [id], onDelete: Cascade)
  referee         User?        @relation("DisputeReferee", fields: [refereeId], references: [id], onDelete: SetNull)
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?
  title          String
  message        String
  type           String   @default("SYSTEM") // "TOURNAMENT", "REGISTRATION", "LOBBY", "CREDENTIALS", "RESULT", "DISPUTE", "SYSTEM"
  read           Boolean  @default(false)
  linkUrl        String?
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  organizationId String?
  action         String
  entityType     String
  entityId       String
  metadata       String?
  createdAt      DateTime      @default(now())

  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}
